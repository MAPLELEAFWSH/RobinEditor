# 编辑器统一口径：这个工程里所有文本文件都是 UTF-8 + LF。
# 之所以写死在配置里，是因为**改文本文件绝不能用 PowerShell 的
# Set-Content / Out-File**（会加 BOM、转 CRLF、中文乱码），
# 而好的编辑器认得 .editorconfig，能帮着守住。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,js,mjs,svelte,css,json}]
indent_size = 2

[*.{rs,toml}]
indent_size = 4

[*.md]
# Markdown 里行尾两个空格是硬换行，别被编辑器吃掉
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,webp,gif,ico,raw}]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
